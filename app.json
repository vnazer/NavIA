{
  "expo": {
    "name": "NavIA",
    "slug": "navia",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "navia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.magama.navia"
    },
    "android": {
      "package": "cl.magama.navia",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
