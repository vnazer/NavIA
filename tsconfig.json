{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@navia/shared-types": ["./packages/shared-types/src"],
      "@navia/shared-types/*": ["./packages/shared-types/src/*"],
      "@navia/polars": ["./packages/polars/src"],
      "@navia/polars/*": ["./packages/polars/src/*"],
      "@navia/nav-utils": ["./packages/nav-utils/src"],
      "@navia/nav-utils/*": ["./packages/nav-utils/src/*"]
    },
    "module": "esnext",
    "moduleResolution": "node"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "_design-system",
    "node_modules"
  ]
}
