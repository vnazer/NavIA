# NavIA — Apache rewrite para Expo Router (output: static)
# Hostinger usa Apache; este fallback evita 404 en rutas dinámicas
# como /bitacora/{id} sirviendo el index.html principal y dejando
# que el client-side router de Expo Router resuelva la ruta.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si el archivo solicitado existe, servirlo tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Para rutas dinámicas con id (ej. /bitacora/regata-xxx),
  # caer al index.html de la ruta padre si existe.
  RewriteRule ^bitacora/[^/]+/?$ /bitacora/index.html [L]

  # Cualquier otra ruta sin match → root index.html (SPA fallback).
  RewriteRule ^ /index.html [L]
</IfModule>

# MIME types correctos
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

# Cache largo para assets versionados de Expo (_expo/static/...)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

# Headers explícitos de Cache-Control (más universal que mod_expires).
# HTML nunca se cachea — siempre se chequea contra el server para que
# un deploy nuevo se vea de inmediato. Los JS/CSS de Expo tienen hash
# en el nombre, así que son immutables y se cachean por 1 año.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "_expo/static/.*\.(js|css|png|jpg|jpeg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
